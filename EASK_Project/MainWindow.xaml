<Window x:Class="EASK_Project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterScreen"
        Title="Расчёт расхода топлива" Width="600" Height="480" MinWidth="520" MinHeight="460">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel x:Name="SelectionPanel" IsEnabled="False">
                <GroupBox Header="Маршрут">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="154"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Label Content="Пункт _отправки:" Target="{Binding ElementName=DepartureComboBox}"/>
                        <ComboBox x:Name="DepartureComboBox" Grid.Column="1" IsEditable="False"
                                  SelectionChanged="DepartureComboBox_SelectionChanged"/>
                        <Label Grid.Row="2" Content="Пункт _прибытия:" Target="{Binding ElementName=ArrivalComboBox}"/>
                        <ComboBox x:Name="ArrivalComboBox" Grid.Row="2" Grid.Column="1" IsEnabled="False" IsEditable="False"
                                  SelectionChanged="ArrivalComboBox_SelectionChanged"/>
                        <Label Grid.Row="4" Content="Расстояние, км:" Target="{Binding ElementName=DistanceTextBox}"/>
                        <TextBox x:Name="DistanceTextBox" Grid.Row="4" Grid.Column="1" Width="130" HorizontalAlignment="Left"
                                 IsReadOnly="True" TextAlignment="Right" Text="—"/>
                        <TextBlock x:Name="RouteHint" Grid.Row="5" Grid.Column="1" Style="{StaticResource HintText}"
                                   Text="Сначала выберите пункт отправки."/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Автомобиль" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="154"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Label Content="_Марка автомобиля:" Target="{Binding ElementName=CarBrandComboBox}"/>
                        <ComboBox x:Name="CarBrandComboBox" Grid.Column="1" DisplayMemberPath="Name" IsEditable="False"
                                  SelectionChanged="CarBrandComboBox_SelectionChanged"/>
                        <TextBlock x:Name="ConsumptionHint" Grid.Row="1" Grid.Column="1" Style="{StaticResource HintText}"
                                   Text="Норма расхода не выбрана."/>
                    </Grid>
                </GroupBox>
            </StackPanel>

            <Grid Grid.Row="1" Margin="18,16,18,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="154"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Content="Расход топлива, л:" FontWeight="SemiBold" Target="{Binding ElementName=FuelTextBox}"/>
                <TextBox x:Name="FuelTextBox" Grid.Column="1" Width="130" HorizontalAlignment="Left" IsReadOnly="True"
                         TextAlignment="Right" FontSize="22" FontWeight="SemiBold" Text="—"/>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,16,0,0" HorizontalAlignment="Right">
                <Button x:Name="OpenDataButton" Content="Маршруты и _автомобили…" IsEnabled="False" Click="OpenDataButton_Click"/>
                <Button x:Name="RetryButton" Content="Повторить подключение" Visibility="Collapsed" Margin="0,8,0,0" Click="RetryButton_Click"/>
            </StackPanel>

            <TextBlock x:Name="StatusText" Grid.Row="3" Margin="2,12,2,0" Foreground="{StaticResource SecondaryBrush}"
                       FontSize="12" Text="Подключение к базе данных…"/>
        </Grid>
    </ScrollViewer>
</Window>
